DATABASE_URL=postgresql://user:password@localhost/dbname
SECRET_KEY=my_secret_key

# QCF-driven parallel data feed: nexus-x-aibank.com <-> nexus-x-aibank-crypto.base44.app
# WebSocket endpoints for real-time bidirectional streaming
NEXUS_PRIMARY_WS_URL=wss://nexus-x-aibank.com
NEXUS_CRYPTO_WS_URL=wss://nexus-x-aibank-crypto.base44.app
# REST endpoints for fallback and scheduled reconciliation sync
NEXUS_PRIMARY_HTTP_URL=https://nexus-x-aibank.com/api/data-feed
NEXUS_CRYPTO_HTTP_URL=https://nexus-x-aibank-crypto.base44.app/api/data-feed
